# Laravel API base URL (server-side only; the browser talks to this app's /api/shop BFF)
API_URL=http://localhost:8000/api/v1

# Root platform domain. Stores live at <slug>.<PLATFORM_DOMAIN>; app.<PLATFORM_DOMAIN> is the dashboard.
# Local development: use "localhost" and open http://icecream.localhost:3000
PLATFORM_DOMAIN=localhost

# Scheme for absolute storefront URLs (canonical, sitemap, payment callbacks). Use https in production.
STOREFRONT_SCHEME=http

# Seconds a store's bundle/catalogue may be served from the Next data cache
STOREFRONT_REVALIDATE=60

# Extra hostnames product images may be served from (comma separated). Cloudinary and DigitalOcean Spaces
# (including their *.cdn.digitaloceanspaces.com addresses) are built in. Add a custom CDN domain here
# (e.g. cdn.example.com) if you put one in front of Spaces. Needed at build time as well as run time.
IMAGE_HOSTS=

# Optional: serve /_next/static from a CDN. Set to the CDN origin (e.g. https://static.example.com) and point it at this app.
ASSET_PREFIX=
